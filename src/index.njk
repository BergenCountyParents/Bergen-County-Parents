---
layout: base.njk
title: Home
description: Things to do, events, and parenting resources for families across Bergen County, NJ.
activeNav: home
permalink: index.html
---
{% set posts = collections.posts %}
{% set featured = posts[0] %}
<main class="wrap">

  <div class="site-banner">
    <span class="banner-photo-label">Photo placeholder — brand banner image</span>
    <div class="site-banner-scrim">
      <span>Bergen County, New Jersey</span>
      <h2>Family life, rooted local</h2>
    </div>
  </div>

  {% if featured %}
  <section class="featured-story">
    <span class="eyebrow">This week's lead story</span>
    <div class="leaf-chip" style="--leaf:{{ featured.data.leafColor }}">
      <svg viewBox="0 0 200 200" fill="none"><path d="M100 20 C150 40 170 90 150 140 C130 180 100 190 100 190 C100 190 70 180 50 140 C30 90 50 40 100 20 Z" stroke="currentColor" stroke-width="14"/></svg>
      <span class="leaf-chip-town">{{ featured.data.town }}</span>
    </div>
    <h1>{{ featured.data.title }}</h1>
    <p class="dek">{{ featured.data.dek }}</p>
    <a href="{{ featured.url }}" class="read-link">Read the full story <span aria-hidden="true">→</span></a>
  </section>
  {% endif %}

  <div class="section-divider">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2 C17 5 19 11 16 16 C13 20 11 21 11 21 C11 21 9 20 6 16 C3 11 5 5 11 2 Z" stroke="currentColor" stroke-width="2"/></svg>
    <span>Latest posts</span>
  </div>

  <section class="post-grid">
    {% for post in posts %}
      {% if not loop.first %}
      <article class="post-card post-card-photo">
        <div class="post-photo">Photo placeholder</div>
        <div class="post-topline">
          <span class="leaf-chip" style="--leaf:{{ post.data.leafColor }}">
            <svg viewBox="0 0 200 200" fill="none"><path d="M100 20 C150 40 170 90 150 140 C130 180 100 190 100 190 C100 190 70 180 50 140 C30 90 50 40 100 20 Z" stroke="currentColor" stroke-width="14"/></svg>
            <span class="leaf-chip-town">{{ post.data.town }}</span>
          </span>
        </div>
        <span class="post-kicker">{{ post.data.categoryLabel }}</span>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.dek }}</p>
        <span class="post-meta">{{ post.data.readTime }} min read · {{ post.date | readableDate }}</span>
      </article>
      {% endif %}
    {% endfor %}
  </section>

  <section class="signup">
    <div class="signup-inner">
      <div>
        <span class="eyebrow" style="color:#F0B98A">A short weekly note</span>
        <h2>Nothing else, just what's worth doing</h2>
        <p>One email a week with what's actually worth doing around the county. No sponsored placements, no filler.</p>
      </div>
      <form class="signup-form" onsubmit="return false;">
        <input type="email" placeholder="you@email.com" aria-label="Email address" required>
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>

</main>
